# Configurazione del controller podcast-web (variabili d'ambiente).
# In produzione: /etc/podcast-web/podcast-web.env, letto dall'unita' systemd.

# demo = utente fisso, solo 127.0.0.1 · cms = header firmati dal CMS di LIFE
AUTH_MODE=cms
HOST=127.0.0.1
PORT=8765

# Cartella di podcast-agent (assoluta). Il python e' sempre $AGENT_DIR/.venv/bin/python.
AGENT_DIR=/srv/lil/podcast-agent
# Contenuto atteso di $AGENT_DIR/VERSION: se diverso, il controller non parte.
AGENT_VERSIONE_ATTESA=1.0-web
# Cartelle in piu' nel PATH dei sottoprocessi (es. ffmpeg di sistema), separate da ":".
AGENT_PATH_EXTRA=

# Segreto condiviso con il CMS (almeno 32 byte, es. `openssl rand -hex 32`).
LIL_SEGRETO=
# Durante la rotazione: il segreto precedente, accettato finche' il CMS non e' aggiornato.
LIL_SEGRETO_PRECEDENTE=
FIRMA_TOLLERANZA_S=60

# Solo AUTH_MODE=demo
DEMO_UTENTE=demo
DEMO_NOME=Utente demo

# Tabella ruolo -> permessi (vuoto = app/servizi/permessi_default.json)
PERMESSI_FILE=
# Registro attivita' (JSONL append-only): includerlo nei backup.
# La cartella (0700) e il file (0600) devono essere dell'utente di servizio: il controller crea
# la cartella se manca. Tenerne una copia anche FUORI dal server (DEPLOY.md §7).
REGISTRO_FILE=/var/lib/podcast-web/registro/registro_attivita.jsonl

GETTONE_DURATA_S=300
CODA_MAX=20
MAX_VOCE_BYTES=20971520
MAX_BRANO_BYTES=52428800
LOG_LIVELLO=INFO
