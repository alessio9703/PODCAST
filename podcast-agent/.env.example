# Copia questo file in `.env` e riempi i valori. `.env` non va committato.

# --- OBBLIGATORIA ---
# API key di Fish Audio — si genera su https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=

# --- OPZIONALE ---
# Serve SOLO a run.py (la CLI classica), che fa scrivere il copione all'API
# Anthropic. Se usi il subagent @podcast-agent il copione lo scrive lui in
# conversazione e questa chiave non serve: lascia la riga vuota.
# Nota: e' una chiave API a consumo, diversa dall'abbonamento Claude Pro/Max.
# Si genera su https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
